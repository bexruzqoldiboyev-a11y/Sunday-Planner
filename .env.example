# ---------------------------------------------------------------- SERVER ----
PORT=5050
CLIENT_ORIGIN=http://localhost:5173

# Joylarning REAL fotosuratlari uchun (Google Places API New).
# Boʻsh boʻlsa — interfeys oʻzining jonli SVG sahnasini koʻrsatadi.
# Olish: console.cloud.google.com → "Places API (New)" → API key
GOOGLE_MAPS_API_KEY=

# Ixtiyoriy: reja sarlavhasini AI yozadi. Boʻsh boʻlsa shablon matn ishlatiladi.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Joylar manbai: demo (JSON fayl) | google (kelajakda jonli qidiruv)
PLACES_PROVIDER=demo

# ---------------------------------------------------------------- CLIENT ----
# Bu qatorlar client/.env fayliga yoziladi:
#
# VITE_MEDIA_ENABLED=true          # oʻz rasm/videolaringizni yoqadi
# VITE_HERO_VIDEO=/media/hero.mp4  # bosh sahifadagi real video
# VITE_OFFLINE=true                # serversiz statik build
